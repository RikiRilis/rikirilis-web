---
import ArticleCard from "@/components/ArticleCard.astro"
import MainTitle from "@/components/MainTitle.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Book from "@/icons/Book.astro"
import { buildArticlesIndexJsonLd, sortArticlesByDate } from "@/libs/articlesSeo"
import {
	getActiveLocale,
	getI18N,
	resolveLocalizedHref,
	resolveLocalizedPath,
} from "@/locales/index"
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const articles = sortArticlesByDate(await getCollection("articles"))
const canonical = new URL(
	resolveLocalizedPath("/articles/", locale),
	"https://rixel.dev"
).toString()
const pageTitle = i18n.ARTICLES_INDEX_TITLE
const pageDescription = i18n.ARTICLES_INDEX_SEO_DESCRIPTION
const featuredImage = articles[0]?.data.cover ?? "https://rixel.dev/images/embedded-img.avif"
const jsonLd = buildArticlesIndexJsonLd({
	articles,
	locale,
	title: pageTitle,
	description: pageDescription,
	canonical,
})
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonical={canonical}
	image={featuredImage}
	keywords={i18n.ARTICLES_INDEX_KEYWORDS}
	jsonLd={jsonLd}
>
	<SectionContainer>
		<div class="flex w-full max-w-4xl flex-col gap-4 sm:w-11/12 md:w-8/12">
			<nav aria-label="Breadcrumb">
				<ol class="flex flex-wrap items-center gap-2 text-sm text-secondary">
					<li>
						<a href={resolveLocalizedHref("/", locale)} class="transition-colors hover:text-accent">
							{i18n.HOME}
						</a>
					</li>
					<li aria-hidden="true" class="text-secondary/50">/</li>
					<li>
						<span class="text-primary" aria-current="page">{i18n.ARTICLES}</span>
					</li>
				</ol>
			</nav>

			<header>
				<MainTitle>
					<Book class="size-8" />
					{i18n.ARTICLES}
				</MainTitle>

				<p
					class="-mt-4 mb-6 max-w-3xl text-pretty text-base leading-relaxed text-primary sm:text-lg"
				>
					{pageDescription}
				</p>
			</header>
		</div>

		<section
			class="flex w-full max-w-4xl flex-col gap-14 sm:w-11/12 md:w-8/12"
			aria-label={i18n.ARTICLES}
		>
			{
				articles.map((article) => {
					const { data } = article
					const { cover, description, pageTitle, tags, title } = data

					return (
						<ArticleCard
							cover={cover}
							description={description}
							pageTitle={pageTitle}
							tags={tags}
							title={title}
						/>
					)
				})
			}
		</section>
	</SectionContainer>
</Layout>
