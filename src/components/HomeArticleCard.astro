---
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"

interface Props {
	author: string
	description: string
	lang: string
	pageTitle: string
	timestamp: string
	title: string
}

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const { author, description, lang, pageTitle, timestamp, title } = Astro.props
const articleHref = resolveLocalizedHref(`/articles/${pageTitle}`, locale)
---

<a
	href={articleHref}
	data-story-id={pageTitle}
	title={`${i18n.READ} → ${title}`}
	class="group relative flex h-full w-full flex-col justify-between gap-4 overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-slate-800/30 via-slate-900/50 to-slate-950/60 p-5 shadow-lg shadow-black/20 backdrop-blur-md transition-all duration-300 ease-out active:scale-[0.98] sm:cursor-pointer sm:hover:border-accent/25 sm:hover:shadow-xl sm:hover:shadow-accent/5"
>
	<div
		class="pointer-events-none absolute -right-8 -top-8 size-24 rounded-full bg-accent/5 transition-all duration-500 sm:group-hover:bg-accent/10"
		aria-hidden="true"
	>
	</div>

	<div class="relative flex-1 overflow-hidden">
		<h3
			class="line-clamp-2 text-base font-bold leading-snug text-slate-100 transition-colors duration-300 sm:group-hover:text-accent"
			transition:name={`article-${pageTitle}-title`}
		>
			{title}
		</h3>

		<p
			class="mt-2 line-clamp-2 text-sm leading-relaxed text-primary/80 transition-colors duration-300"
			transition:name={`article-${pageTitle}-content`}
		>
			{description}
		</p>
	</div>

	<div class="relative flex items-end justify-between gap-3">
		<div class="flex flex-col gap-0.5">
			<p class="text-[10px] text-secondary/70 sm:text-xs">
				{timestamp}
			</p>
			<p class="text-[10px] text-secondary/70 sm:text-xs">
				{author} · {lang}
			</p>
		</div>

		<div
			class="flex size-8 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-all duration-300 sm:group-hover:border-accent/30 sm:group-hover:bg-accent/10"
		>
			<RightArrow
				class="size-4 text-primary transition-all duration-300 sm:group-hover:translate-x-0.5 sm:group-hover:text-accent"
			/>
		</div>
	</div>
</a>
