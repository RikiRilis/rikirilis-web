---
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
---

<a
	class="group relative flex h-full w-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-slate-800/40 via-slate-900/60 to-slate-950/80 shadow-xl shadow-black/30 backdrop-blur-md transition-all duration-500 ease-out active:scale-[0.98] sm:cursor-pointer sm:hover:border-accent/25 sm:hover:shadow-2xl sm:hover:shadow-accent/10"
	href={resolveLocalizedHref("/photography", locale)}
	rel="noopener noreferrer"
>
	<div class="relative grid aspect-[4/3] grid-cols-2 grid-rows-2 gap-0.5 overflow-hidden p-0.5">
		<img
			src="https://www.rixel.dev/portraits/16.webp"
			alt={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} 16`}
			class="h-full w-full object-cover transition-transform duration-700 sm:group-hover:scale-110"
		/>
		<img
			src="https://www.rixel.dev/portraits/34.webp"
			alt={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} 34`}
			class="h-full w-full object-cover transition-transform duration-700 delay-75 sm:group-hover:scale-110"
		/>
		<img
			src="https://www.rixel.dev/portraits/21.webp"
			alt={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} 21`}
			class="h-full w-full object-cover transition-transform duration-700 delay-150 sm:group-hover:scale-110"
		/>
		<img
			src="https://www.rixel.dev/portraits/50.webp"
			alt={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} 50`}
			class="h-full w-full object-cover transition-transform duration-700 delay-200 sm:group-hover:scale-110"
		/>

		<div
			class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"
		>
		</div>
	</div>

	<div class="flex flex-1 items-center justify-between gap-4 p-5 sm:p-6">
		<div class="flex-1">
			<h2
				class="text-lg font-bold text-slate-100 transition-colors duration-300 sm:group-hover:text-accent"
			>
				{i18n.PHOTOGRAPHY_PORTFOLIO_TITLE}
			</h2>

			<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-primary/90">
				{i18n.PHOTOGRAPHY_DESCRIPTION}
			</p>
		</div>

		<div
			class="flex size-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-all duration-300 sm:group-hover:border-accent/30 sm:group-hover:bg-accent/10"
		>
			<RightArrow
				class="size-5 text-primary transition-all duration-300 sm:group-hover:translate-x-0.5 sm:group-hover:text-accent"
			/>
		</div>
	</div>
</a>
